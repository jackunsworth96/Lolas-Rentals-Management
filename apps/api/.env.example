# Supabase
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-sb-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-key-here


# JWT
JWT_SECRET=your-jwt-secret-here


# Google Sheets (background sync only)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGIN=your-allowed-origin-here

# Email (Resend)
RESEND_API_KEY=your-resend-api-key-here
NOTIFICATION_EMAIL=hello@lolasrentals.com
EMAIL_FROM_CUSTOMER=hello@lolasrentals.com
EMAIL_FROM_BOOKINGS=bookings@lolasrentals.com
EMAIL_FROM_INTERNAL=maintenance@lolasrentals.com
DRIVER_EMAIL=driver@example.com

# External APIs
AERODATABOX_API_KEY=your-aerodatabox-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Telegram (one bot handles all channels)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-default-chat-id-here
TELEGRAM_OPS_CHAT_ID=your-ops-channel-chat-id-here
TELEGRAM_FLEET_CHAT_ID=your-fleet-channel-chat-id-here
TELEGRAM_DAILY_CHAT_ID=your-daily-updates-channel-chat-id-here
TELEGRAM_MAINTENANCE_CHAT_ID=your-maintenance-channel-chat-id-here
TELEGRAM_DRIVER_CHAT_ID=your-driver-channel-chat-id-here
TELEGRAM_VAN_CHAT_ID=your-van-driver-channel-chat-id-here
TELEGRAM_TUKTUK_CHAT_ID=your-tuktuk-driver-channel-chat-id-here
TELEGRAM_FEEDBACK_CHAT_ID=your-feedback-channel-chat-id-here
TELEGRAM_PAID_ORDERS_CHAT_ID=your-paid-orders-channel-chat-id-here
TELEGRAM_TODO_CHAT_ID=your-todo-channel-chat-id-here

# Email unsubscribe (HMAC signing key for one-click unsubscribe tokens)
# Random secret string, min 32 chars — e.g. openssl rand -hex 32
UNSUBSCRIBE_SECRET=your-random-secret-min-32-chars-here

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
