# Copy to .env and fill in values. (.env is gitignored.)

VITE_API_URL=

# Supabase Dashboard → Project Settings → API:
# - Project URL → VITE_SUPABASE_URL
# - "anon" "public" key under Project API keys → VITE_SUPABASE_ANON_KEY
# Never put the service_role key in the web app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional — leave blank to disable)
VITE_SENTRY_DSN=

# Beta error notice — shows a WhatsApp contact banner whenever any error occurs.
# Set to true while the site is new / in beta. Remove or set to false once stable.
VITE_BETA_ERROR_NOTICE=false

# Paw Card partner strip: Cloudinary public ID for Outer Cafe if the default asset 404s
# (copy from Cloudinary Media Library → asset details → Public ID). Also set the same
# value on `paw_card_establishments.cloudinary_public_id` for Outer Cafe.
# VITE_OUTER_CAFE_LOGO_ID=outer-cafe_xxxxxxxx
