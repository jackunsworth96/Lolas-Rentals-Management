# Supabase
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-sb-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-key-here


# JWT
JWT_SECRET=your-jwt-secret-here


# Google Sheets (background sync only)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGIN=your-allowed-origin-here

# External APIs
AERODATABOX_API_KEY=your-aerodatabox-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Respond.io (used by /api/public/respond/* auth)
RESPOND_IO_API_KEY=your-secret-key-here
RESPOND_IO_API_URL=https://api.respond.io
RESPOND_IO_OUTBOUND_TOKEN=
RESPOND_IO_WHATSAPP_CHANNEL_ID=501809
RESPOND_IO_POST_RENTAL_REVIEW_CHANNEL_ID=501809
RESPOND_IO_POST_RENTAL_REVIEW_TEMPLATE_NAME=post_rental_review
RESPOND_IO_POST_RENTAL_REVIEW_TEMPLATE_LANGUAGE=en

# Website chat backend switch (custom public UI + respond.io workflow/webhook)
RESPOND_IO_CHAT_ENABLED=false
RESPOND_IO_CHAT_WEBHOOK_URL=
RESPOND_IO_CHAT_API_KEY=
RESPOND_IO_CHAT_TIMEOUT_MS=12000
RESPOND_IO_CHAT_FALLBACK_TO_ANTHROPIC=true
CHAT_SSE_CHUNK_SIZE=28
CHAT_SSE_CHUNK_DELAY_MS=20

# Server
PORT=3001
NODE_ENV=development
ENABLE_MONTHLY_DEPRECIATION_JOB=false
